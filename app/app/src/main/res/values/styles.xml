<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="editTextStyle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">#363636</item>
        <item name="android:textColorHint">#363636</item>
        <item name="android:padding">10dp</item>
        <item name="android:scrollHorizontally">true</item>
    </style>

    <style name="buttonStyle">
        <item name="android:layout_width">110dp</item>
        <item name="android:layout_height">50dp</item>
        <item name="android:layout_gravity">center</item>
        <item name="backgroundTint">#708090</item>
    </style>

    <style name="logoutbuttonStyle">
        <item name="android:layout_width">110dp</item>
        <item name="android:layout_height">50dp</item>
        <item name="android:layout_gravity">center</item>
        <item name="backgroundTint">#99CC0000</item>
    </style>

    <style name="startbuttonStyle">
        <item name="android:layout_width">110dp</item>
        <item name="android:layout_height">50dp</item>
        <item name="android:layout_gravity">center</item>
        <item name="backgroundTint">#994CAF50</item>
    </style>


</resources>